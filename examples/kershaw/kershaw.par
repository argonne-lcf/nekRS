userSections = CASEDATA

[GENERAL] 
#verbose = true 
polynomialOrder = 7
timeStepper = tombo2
advectionSubCyclingSteps = 1
stopAt = numSteps
numSteps = 0

[MESH]
hrefine = 2 # split factor per direction 

[ELLIPTIC BP5]
poisson = true
preconditioner = none 
solver = CG+maxIter=1000
residualTol = 1e-15

[ELLIPTIC BP6]
poisson = true
preconditioner = none 
solver = CG+block+maxIter=500
residualTol = 1e-15

[ELLIPTIC BPS5]
poisson = true
solver = gmres+flexible+nVector=15 
residualTol = 1e-8+relative
initialGuess = previous

# p-MG multiplicative V-cycle, coarse grid solve
preconditioner = multigrid
smootherType = RAS+FourthOptChebyshev #+maxEigenvalueBoundFactor=1.1
coarseSolver = boomerAMG #+device
#coarseGridDiscretization = FEM #+Galerkin
#pMGSchedule = p=7+degree=3, p=3+degree=3, p=1, p=3+degree=3, p=7+degree=3

# p-MG additive V-cycle, overlapping coarse grid solve
#preconditioner = multigrid+additive
#coarseSolver = boomerAMG+cpu+overlap
#smootherType = ASM

# smoothed SEMFEM
#preconditioner = semfem #+non-smoothed
#smootherType = JAC+FourthOptChebyshev #+maxEigenvalueBoundFactor=1.1
#pMGSchedule = p=7+degree=2, p=7, p=7+degree=2


#[ELLIPTIC BPS5 BOOMERAMG]
#coarsenType = 8 
#interpolationType = 6
#smootherType = 16
#coarseSmootherType = 9 
#iterations = 1
#strongThreshold = 0.25
#nonGalerkinTol = 0.0
#aggressiveCoarseningLevels = 0
#chebyshevRelaxOrder = 1

[CASEDATA]
gsOverlap = 1

wdotp = true
wdotpRepetitions = 100 

bp5 = true 
bp5Repetitions = 50 

bps5 = true 
bps5Repetitions = 200 
eps = 0.3

bp6 = true 
bp6Repetitions = 50 
